# Changes to these paths can weaken the CI gate, the spec-artifact pin or the
# generated files that consumers load. They need review by a code owner when
# the main ruleset requires it.
/.github/          @dfkunstler
/api-docs/         @dfkunstler
/scripts/          @dfkunstler
/src/generated/    @dfkunstler
/package.json      @dfkunstler
/package-lock.json @dfkunstler
/.npmrc            @dfkunstler
/mise.lock         @dfkunstler
/mise.toml         @dfkunstler
/spec-pin.json     @dfkunstler

# These files hold the behavior that docs/security.md ("Security notes for consumers") describes, and the tests that
# pin it. A change here can make a note false. The reviewer checks that the notes and test/security-notes.test.ts still
# match the code.
/README.md                       @dfkunstler
/docs/security.md                @dfkunstler
/src/*.ts                        @dfkunstler
/test/security-notes.test.ts     @dfkunstler
# These files define what the published package exposes and what it holds.
/src/v1/                         @dfkunstler
/tsconfig.build.json             @dfkunstler
